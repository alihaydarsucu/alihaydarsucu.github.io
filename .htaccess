RewriteEngine On

# Öncelikli yönlendirmeler
# /hakkimda -> /tr (kalici yonlendirme)
RewriteRule ^hakkimda/?$ tr [R=301,L]

# Ana sayfa için
RewriteRule ^$ index.html [L]

# Diğer sayfalar için (İngilizce)
RewriteRule ^skills/?$ skills.html [L]
RewriteRule ^projects/?$ projects.html [L]
RewriteRule ^experience/?$ experience.html [L]
RewriteRule ^photos/?$ photos.html [L]
RewriteRule ^admin/?$ admin.html [L]

# Diğer sayfalar için (Türkçe)
RewriteRule ^tr/?$ index.html [L]
RewriteRule ^yetenekler/?$ yetenekler.html [L]
RewriteRule ^projeler/?$ projeler.html [L]
RewriteRule ^deneyim/?$ deneyim.html [L]
RewriteRule ^fotograflar/?$ fotograflar.html [L]
RewriteRule ^yonetim/?$ yonetim.html [L]

# Blog list sayfaları - EN ve TR
RewriteRule ^posts/?$ blog-en.html [L]
RewriteRule ^yazilar/?$ blog-tr.html [L]

# /blog-tr ve varyasyonlarını /blog-tr.html'e yönlendir
RewriteRule ^blog-tr/?$ blog-tr.html [R=301,L]

# Blog makale sayfaları - slug tabanlı (Clean URLs with fallback)
# /posts/<slug> -> /article-en.html?slug=<slug>
RewriteRule ^posts/([^/]+)/?$ article-en.html?slug=$1 [L,QSA]

# /yazilar/<slug> -> /article-tr.html?slug=<slug>
RewriteRule ^yazilar/([^/]+)/?$ article-tr.html?slug=$1 [L,QSA]

# 404 sayfası için
ErrorDocument 404 /404.html
RewriteRule ^404/?$ 404.html [L]

# .html uzantısını gizle (genel kural - en sonda olmalı)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
