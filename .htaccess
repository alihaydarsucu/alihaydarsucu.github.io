RewriteEngine On

# Öncelikli yönlendirmeler
# /hakkimda -> /tr (kalici yonlendirme)
RewriteRule ^hakkimda/?$ tr [R=301,L]

# Ana sayfa için
RewriteRule ^$ index.html [L]

# Diğer sayfalar için (İngilizce)
RewriteRule ^skills/?$ pages/en/skills.html [L]
RewriteRule ^projects/?$ pages/en/projects.html [L]
RewriteRule ^experience/?$ pages/en/experience.html [L]
RewriteRule ^photos/?$ pages/en/photos.html [L]

# Diğer sayfalar için (Türkçe)
RewriteRule ^yetenekler/?$ pages/tr/yetenekler.html [L]
RewriteRule ^projeler/?$ pages/tr/projeler.html [L]
RewriteRule ^deneyim/?$ pages/tr/deneyim.html [L]
RewriteRule ^fotograflar/?$ pages/tr/fotograflar.html [L]

# Blog list sayfaları - EN ve TR
RewriteRule ^posts/?$ pages/en/blog.html [L]
RewriteRule ^yazilar/?$ pages/tr/blog.html [L]

# /blog-tr ve varyasyonlarını /yazilar'a yönlendir
RewriteRule ^blog-tr/?$ yazilar [R=301,L]

# Blog makale sayfaları - slug tabanlı
# /posts/<slug> -> /pages/en/article.html?slug=<slug>
RewriteRule ^posts/([^/]+)/?$ pages/en/article.html?slug=$1 [L,QSA]

# /yazilar/<slug> -> /pages/tr/article.html?slug=<slug>
RewriteRule ^yazilar/([^/]+)/?$ pages/tr/article.html?slug=$1 [L,QSA]

# 404 sayfası için
RewriteRule ^404/?$ pages/en/404.html [L]

# .html uzantısını gizle (genel kural - en sonda olmalı)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
